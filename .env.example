# Only needed when deployed. Locally the app keeps tables in memory.
# On Vercel these are added for you when you connect "Upstash for Redis"
# from the Storage tab (they may be named KV_REST_API_URL / KV_REST_API_TOKEN,
# which the app also reads).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
